# MongoDB — must be a replica set connection string
MONGODB_URI=mongodb://localhost:27017/ai_accounting?replicaSet=rs0&directConnection=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-in-production-access-secret
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-accounting-docs
S3_REGION=ap-south-1

# Groq
GROQ_API_KEY=your-groq-api-key

# Gemini — vision OCR (tier 3), field extraction, lead scoring, the support agent.
# Required; without it the document pipeline and every CRM AI feature fail.
# Get one from https://aistudio.google.com/apikey and keep it out of version
# control: it is billed per call, so a leaked key costs money as well as data.
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
