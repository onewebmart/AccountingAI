# MongoDB — must be a replica set connection string
MONGODB_URI=mongodb://localhost:27019/ai_accounting?replicaSet=rs0&directConnection=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-in-production-access-secret
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-accounting-docs
S3_REGION=ap-south-1

# Gemini — the one AI provider: reading scans, reading bills, picking accounts
# when no rule fits, HSN codes, quotes from messages, Ask your books, the
# monthly summary, lead scoring and the support agent.
# Without it no upload can be read into an entry (each waits for Add to), but
# every rule still runs: categories by HSN/SAC and past choices, the bill and
# GST checks, bank matching, payment and TDS suggestions.
# Get one from https://aistudio.google.com/apikey and keep it out of version
# control: it is billed per call, so a leaked key costs money as well as data.
GEMINI_API_KEY=your-gemini-api-key
# Optional: the models used (both default to gemini-2.5-flash).
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Razorpay payment links on invoices (optional). Without keys, links are
# mock links for development. The webhook secret verifies POST /webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email-in (optional). Each org gets bills-<code>@INBOUND_EMAIL_DOMAIN. Point
# the domain's MX at Postmark inbound and set the webhook to
# https://inbound:<INBOUND_EMAIL_SECRET>@<api host>/api/v1/inbound/email
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# WhatsApp-in through the WhatsApp Cloud API (optional). Webhook URL:
# <api host>/api/v1/inbound/whatsapp, verified with WHATSAPP_VERIFY_TOKEN;
# messages are checked against WHATSAPP_APP_SECRET. The business number is
# shown to people linking their phone.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_BUSINESS_NUMBER=

# Bank feeds through an Account Aggregator. 'mock' (the default) makes up a
# bank for development. 'setu' uses Setu's AA gateway (FIU v2 API); the API
# refuses to start if it is chosen without credentials. The purpose code must
# match a consent template approved for your FIU in Setu's console. Check the
# adapter against Setu's sandbox before relying on it in production.
BANK_FEED_PROVIDER=mock
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_PURPOSE_CODE=102
SETU_AA_CONSENT_MONTHS=12
# Where the customer lands after approving; defaults to <WEB_URL>/banking.
SETU_AA_REDIRECT_URL=

# GST Suvidha Provider for e-invoices (IRN) and e-way bills. Only 'mock' is
# built: it computes IRNs the way the IRP does and marks everything as a test,
# registering nothing. A real GSP needs its own adapter behind GspProvider.
GSP_PROVIDER=mock
